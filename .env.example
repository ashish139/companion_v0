# Copy this file to .env and fill in your own keys.
# .env is gitignored - never commit real keys.

# --- Picovoice (wake word) --------------------------------------------------
# Free AccessKey from https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=

# The robot's name. In the offline (default) backend this is all you need to
# change to rename it - the name is spotted in the Whisper transcript.
#
# "Golu" is NOT a Porcupine built-in keyword, so the SARVAM backend also needs
# a custom model:
#   1. go to https://console.picovoice.ai
#   2. Porcupine -> train a wake word -> type "Golu"
#   3. platform: Windows (x86_64)
#   4. download, unzip, and point WAKE_WORD_PPN at the .ppn file
WAKE_WORD=Golu
WAKE_WORD_PPN=

# Whisper has never heard the name, so it guesses at the spelling. Leave this
# blank to use the built-in list in commands.py, which was built by running
# real audio through the recogniser.
#
# If the robot ignores you, run `python main.py --debug-audio`, see what
# Whisper actually wrote, and add it here (comma-separated). Avoid adding
# common English words - "hello" is one of Whisper's guesses for "Golu" and
# accepting it would wake the robot constantly.
WAKE_VARIANTS=

# Used only until you have a .ppn, so the app runs today.
# Must be a Porcupine built-in: porcupine, bumblebee, computer, jarvis,
# alexa, americano, blueberry, grapefruit, grasshopper, terminator,
# "hey google", "hey siri", "ok google", "pico clock"
WAKE_WORD_FALLBACK=computer

# 0..1 - higher means more detections and more false alarms
WAKE_SENSITIVITY=0.6

# --- Sarvam (speech to text + text to speech) -------------------------------
# API key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# "auto" detects Hindi vs Indian English per utterance.
# Use hi-IN or en-IN to pin it to one language.
STT_LANGUAGE=auto

# codemix keeps Hinglish as spoken. Alternatives: transcribe, translate,
# verbatim, translit
STT_MODE=codemix

# Pause length that means "they stopped talking", milliseconds
STT_SILENCE_MS=600

# Give up on one utterance after this many seconds
LISTEN_TIMEOUT_S=8.0

# Sarvam TTS voice and model
TTS_SPEAKER=shubh
TTS_MODEL=bulbul:v3

# --- audio ------------------------------------------------------------------
# Leave blank for the Windows default microphone.
# Run `python -m sounddevice` to list device indices.
MIC_DEVICE=
